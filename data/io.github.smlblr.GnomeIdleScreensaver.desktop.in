[Desktop Entry]
Type=Application
Name=Screensaver
Name[tr]=Ekran Koruyucu
GenericName=Screensaver settings
GenericName[tr]=Ekran koruyucu ayarları
Comment=Settings for the screensaver that shows a full-screen animation when the computer is idle
Comment[tr]=Bilgisayar boşta kalınca tam ekran animasyon gösteren ekran koruyucunun ayarları
Exec=@BINARY@ settings
Icon=io.github.smlblr.GnomeIdleScreensaver
Terminal=false
Categories=Settings;DesktopSettings;GTK;
